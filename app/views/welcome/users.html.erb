<h1>Flipper Demo - Users</h1>

<%= link_to "Back", root_path %>

<ul>
  <% @users.each do |user| %>
    <li>
      <%= user.name %>
      <span class="<%= Flipper.enabled?(:search, user) ? "checkmark" : "crossmark" %>"></span>
      <%= button_to "Toggle", toggle_user_path(user), method: :post %>
    </li>
  <% end %>
</ul>